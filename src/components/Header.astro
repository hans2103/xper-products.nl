---
import { Image } from 'astro:assets';
import logo from '../assets/logo-xper.png';

const path = Astro.url.pathname;
const links = [
  { href: '/producten/', label: 'Producten' },
  { href: '/ondernemers/', label: 'Voor winkeliers' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Xpèr Products, naar de homepage">
      <Image src={logo} alt="" width={150} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="site-nav" aria-label="Hoofdmenu">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
